{"Version": "2012-10-17", "Statement": [
  {"Sid": "OMDDiscoverBuckets", "Effect": "Allow", "Action": ["s3:ListAllMyBuckets"], "Resource": "*"},
  {"Sid": "Glue", "Effect": "Allow", "Action": ["glue:GetTables", "glue:GetDatabases"], "Resource": [
    "arn:aws:glue:us-east-1:595738433757:catalog", "arn:aws:glue:us-east-1:595738433757:database/*", "arn:aws:glue:us-east-1:595738433757:table/*"]},
  {"Sid": "DynamoDB", "Effect": "Allow", "Action": ["dynamodb:ListTables", "dynamodb:DescribeTable", "dynamodb:Scan"],
   "Resource": ["arn:aws:dynamodb:us-east-1:595738433757:table/*"]}]}
