{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cencosud.data/schemas/semantic_review.schema.json",
  "title": "Salida del revisor semántico (LLM local)",
  "description": "Contrato que el LLM debe cumplir; govkit verifica citas (kb_rule_id) y grounding (evidence_quote) antes de publicar.",
  "type": "object",
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kb_rule_id",
          "verdict",
          "confidence",
          "artifact",
          "evidence_quote",
          "rationale"
        ],
        "properties": {
          "kb_rule_id": {
            "type": "string",
            "pattern": "^KB\\d{2}\\.[RAHV]\\d+$"
          },
          "verdict": {
            "enum": [
              "cumple",
              "no_cumple",
              "insuficiente_informacion"
            ]
          },
          "severity_suggested": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "artifact": {
            "type": "string"
          },
          "evidence_quote": {
            "type": "string",
            "maxLength": 300
          },
          "rationale": {
            "type": "string",
            "maxLength": 600
          },
          "remediation": {
            "type": "string",
            "maxLength": 600
          }
        }
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
