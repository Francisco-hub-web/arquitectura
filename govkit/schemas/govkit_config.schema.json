{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cencosud.data/schemas/govkit_config.schema.json",
  "title": ".govkit.yaml — configuración por repositorio",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "repo_name": {
      "type": "string"
    },
    "pack": {
      "type": "string"
    },
    "policies": {
      "type": "object"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "disable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severity": {
          "type": "object"
        }
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "reason",
          "owner",
          "adr",
          "expires"
        ]
      }
    }
  }
}
